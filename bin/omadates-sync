#!/usr/bin/env python3
"""Fetch calendar events into a JSON cache the Omarchy shell can read.

The shell never talks to the network. It watches one JSON file and redraws,
which is what keeps the calendar popup instant and keeps it useful offline,
showing the last good sync rather than a spinner.

Subcommands (the panel drives all of these; they also work by hand):
    sync                  Refresh the cache. The default.
    poll                  Sync only if the server says something changed.
    login <apple-id>      Store a password read from stdin, then sync.
    logout                Forget the account and its password.
    create                Write one event, read as JSON on stdin.
    delete                Remove one event, read as JSON on stdin.
    colour                Set a calendar's colour on the server, JSON on stdin.
    newcalendar           Make a calendar on the server, JSON on stdin.
    deletecalendar        Remove a calendar, or drop a feed. JSON on stdin.
    map <location>        Open a location in the system's map handler.
    subscribe <url>       Add a webcal:// or https://….ics feed, then sync.
    unsubscribe <url>     Drop a feed, then sync.
    check                 Report missing dependencies as JSON. Never fails.

Passwords live in the login keyring via secret-tool, never in the config file.
"""

import json
import os
import subprocess
import sys
import traceback
import uuid
from datetime import date, datetime, time, timedelta, timezone
from pathlib import Path

APP = "omadates"
KEYRING_SERVICE = "io.github.gabbe2312.calendar"

CONFIG_PATH = Path.home() / ".config" / "omarchy" / APP / "config.json"
CACHE_PATH = Path.home() / ".cache" / "omarchy" / APP / "events.json"
TOKENS_PATH = Path.home() / ".cache" / "omarchy" / APP / "sync-tokens.json"

DEFAULTS = {
    # Apple's CalDAV endpoint. Any other CalDAV server works too: Fastmail,
    # Nextcloud, a self-hosted Radicale, by putting its URL here.
    "url": "https://caldav.icloud.com/",
    "username": "",
    "daysBack": 31,
    "daysAhead": 120,
    # Empty means every calendar the account exposes; otherwise a list of
    # display names to keep.
    "calendars": [],
    # Subscribed calendars (webcal:// or https://….ics). iCloud never stores
    # these. The phone keeps only the URL and fetches the source itself, so
    # they are pulled from the same place the phone pulls them from.
    "subscriptions": [],
}

# Some invitations carry pages of dial-in boilerplate. The panel shows notes,
# not a mail body, so this keeps the opening of it and drops the rest.
DESCRIPTION_LIMIT = 600

# A half-open connection otherwise waits forever, and the panel sits saying
# "Creating…" until the shell is restarted. Long enough for a slow line,
# short enough to be an answer rather than a hang.
NETWORK_TIMEOUT = 25

# State is written 0600 inside 0700 directories. The cache holds the titles,
# places and notes of everything on the calendar, and the config holds the
# Apple ID; neither is anyone else's business on a shared machine.
STATE_MODE = 0o600
STATE_DIR_MODE = 0o700

# A subscribed feed is a URL somebody pasted, and what comes back is a file a
# stranger controls. Both ends of that are bounded: how big the file may be,
# and how many redirects it may send us through.
MAX_FEED_BYTES = 8 * 1024 * 1024
MAX_REDIRECTS = 5

# One calendar cannot be allowed to make the panel unusable. Titles are cut to
# a length a line can hold, and the whole cache to a number of events the shell
# can lay out without stalling; a feed with a hundred thousand entries in the
# window is a broken feed, not a busy month.
SUMMARY_LIMIT = 200
LOCATION_LIMIT = 200
MAX_EVENTS = 5000

REQUIREMENTS = [
    ("caldav", "python-caldav"),
    ("icalendar", "python-icalendar"),
    ("recurring_ical_events", "python-recurring-ical-events"),
    # caldav 3.x reaches into its async client even on the sync path, and that
    # module refuses to import without an async HTTP library present.
    ("httpx", "python-httpx"),
    ("requests", "python-requests"),
]


# ---------------------------------------------------------------- state files

def secure_dir(path):
    path.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(path, STATE_DIR_MODE)
    except OSError:
        pass


def write_private(path, text):
    """Write a state file atomically, privately, and without following a link.

    O_NOFOLLOW on the temporary file means a symlink planted at that name is an
    error rather than a way to have this process write somewhere else as the
    user who owns it. os.replace then swaps the finished file into place in one
    step, which is what keeps the shell's file watcher from ever reading half a
    cache, and which replaces a symlink at the destination rather than writing
    through it.
    """
    secure_dir(path.parent)
    tmp = path.with_name(path.name + ".tmp")
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, STATE_MODE)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    os.replace(tmp, path)


def read_private(path):
    """Read a state file this program wrote, refusing to follow a link there."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return ""
    with os.fdopen(fd, "r", encoding="utf-8") as handle:
        return handle.read()


# ---------------------------------------------------------------- config

def load_config():
    config = dict(DEFAULTS)
    if CONFIG_PATH.exists():
        try:
            user = json.loads(read_private(CONFIG_PATH) or "{}")
            if isinstance(user, dict):
                config.update({k: v for k, v in user.items() if v is not None})
        except Exception as exc:
            raise RuntimeError(f"config {CONFIG_PATH} is not valid JSON: {exc}")
    return config


def save_config(config):
    write_private(CONFIG_PATH, json.dumps(config, indent=2, ensure_ascii=False) + "\n")


# ---------------------------------------------------------------- keyring

def keyring_lookup(username):
    try:
        result = subprocess.run(
            ["secret-tool", "lookup", "service", KEYRING_SERVICE, "account", username],
            capture_output=True, text=True, timeout=15,
        )
    except FileNotFoundError:
        raise RuntimeError("secret-tool is not installed (package: libsecret)")
    except subprocess.TimeoutExpired:
        raise RuntimeError("the keyring did not answer. Is it unlocked?")
    if result.returncode != 0 or not result.stdout:
        raise RuntimeError("no password in the keyring. Sign in again")
    return result.stdout.strip("\n")


def keyring_store(username, password):
    try:
        result = subprocess.run(
            ["secret-tool", "store", "--label", f"Omarchy calendar ({username})",
             "service", KEYRING_SERVICE, "account", username],
            input=password, capture_output=True, text=True, timeout=20,
        )
    except FileNotFoundError:
        raise RuntimeError("secret-tool is not installed (package: libsecret)")
    except subprocess.TimeoutExpired:
        raise RuntimeError("the keyring did not answer. Is it unlocked?")
    if result.returncode != 0:
        raise RuntimeError((result.stderr or "could not write to the keyring").strip())


def keyring_clear(username):
    try:
        subprocess.run(["secret-tool", "clear", "service", KEYRING_SERVICE, "account", username],
                       capture_output=True, text=True, timeout=15)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        # Signing out has to work whether or not the keyring answers. The
        # config forgets the account either way, and a password left behind
        # unlocks nothing on its own.
        pass


# ---------------------------------------------------------------- helpers

def local_tz():
    return datetime.now().astimezone().tzinfo


def as_local_datetime(value, tz):
    """Normalise a DTSTART/DTEND into (iso_string, is_all_day)."""
    if isinstance(value, datetime):
        if value.tzinfo is None:
            value = value.replace(tzinfo=tz)
        return value.astimezone(tz).isoformat(), False
    if isinstance(value, date):
        return datetime.combine(value, time.min, tzinfo=tz).isoformat(), True
    return None, False


# Kept because they are part of ordinary text: the joiner that holds a
# multi-part emoji together, and the selectors that choose how one is drawn.
KEPT_FORMAT_CHARS = "\u200d\ufe0e\ufe0f"


def strip_controls(value, keep=""):
    """Drop what has no business being drawn as a line of a panel.

    Control characters break the layout — a newline in a title turns one row
    into two — and the bidirectional overrides are worse than that: they
    reverse the direction of everything after them, which is how a title can be
    made to read as something other than what it says. Neither ever appears in
    a real appointment, so both are removed rather than rendered.
    """
    import unicodedata
    out = []
    for char in str(value or ""):
        if char in keep or char in KEPT_FORMAT_CHARS:
            out.append(char)
            continue
        category = unicodedata.category(char)
        if category[0] == "C" or category in ("Zl", "Zp"):
            continue
        out.append(char)
    return "".join(out)


def clean_line(value, limit):
    """One line of server-supplied text, cut to something a row can hold."""
    text = strip_controls(value).strip()
    if len(text) > limit:
        text = text[:limit].rstrip() + "…"
    return text


def clean_description(value):
    if value is None:
        return ""
    text = strip_controls(str(value).replace("\r\n", "\n").replace("\r", "\n"),
                          keep="\n").strip()
    while "\n\n\n" in text:
        text = text.replace("\n\n\n", "\n\n")
    if len(text) > DESCRIPTION_LIMIT:
        text = text[:DESCRIPTION_LIMIT].rstrip() + "…"
    return text


def normalise_hex(value):
    """Apple writes #RRGGBBAA; QML wants #RRGGBB."""
    text = str(value or "").strip()
    return text[:7] if text.startswith("#") and len(text) >= 7 else ""


# ---------------------------------------------------------------- caldav

def require_https(url, what):
    """Refuse to put credentials, or a calendar, on an unencrypted connection.

    The account's password goes out on every CalDAV request, and what comes
    back is the whole diary. Over http both are readable by anything between
    here and the server, and a redirect on that connection can be rewritten by
    the same party. There is no version of this worth supporting quietly, so
    the address is checked before anything is sent rather than after.
    """
    text = str(url or "").strip()
    if not text.lower().startswith("https://"):
        raise RuntimeError(f"{what} must be an https:// address")
    return text


def dav_client(config, username, password):
    """The only place a CalDAV connection is opened.

    ssl_verify_cert is the default, said out loud because it is the line that
    matters most here. RFC 6764 discovery is off: the address is one this
    machine already holds, so letting a DNS answer nominate some other server
    to send the password to buys nothing and risks exactly that.
    """
    import caldav
    return caldav.DAVClient(
        url=require_https(config.get("url"), "the calendar server address"),
        username=username, password=password,
        timeout=NETWORK_TIMEOUT, ssl_verify_cert=True, enable_rfc6764=False,
    )


def account_calendars(config, username):
    """Sign in and list the account's calendars, or raise something readable."""
    password = keyring_lookup(username)
    return dav_client(config, username, password).principal().calendars()


def calendar_color(calendar):
    """The colour the calendar has in Apple's own apps; absence is fine.

    get_properties wants a property element, not the bare namespaced string.
    handing it a string raises rather than returning nothing.
    """
    try:
        from caldav.elements import ical
    except ImportError:
        return ""
    try:
        for value in calendar.get_properties([ical.CalendarColor()]).values():
            found = normalise_hex(value)
            if found:
                return found
    except Exception:
        pass
    return ""


def takes_events(calendar):
    """Whether a collection accepts VEVENT at all.

    An account's reminder list is a calendar as far as CalDAV is concerned,
    but it holds VTODO, and offering it as somewhere to put an appointment
    would be offering a mistake. A server that declines to say is taken at
    its word rather than excluded.
    """
    try:
        components = calendar.get_supported_components()
    except Exception:
        return True
    if not components:
        return True
    return "VEVENT" in components


def calendar_name(calendar, fallback):
    try:
        name = calendar.get_display_name()
        if name:
            return str(name)
    except Exception:
        pass
    return fallback


def collect_caldav(calendar, start, end, tz, name, color):
    """Every VEVENT in the window, recurrences expanded."""
    try:
        results = calendar.search(start=start, end=end, event=True, expand=True)
    except Exception:
        # Some servers reject server-side expansion; caldav falls back to
        # doing it locally when recurring-ical-events is installed.
        results = calendar.search(start=start, end=end, event=True)

    events = []
    for item in results:
        try:
            component = item.icalendar_instance
        except Exception:
            continue
        for sub in component.walk("VEVENT"):
            built = build_event(sub, tz, name, color, subscribed=False)
            if built:
                events.append(built)
    return events


def build_event(sub, tz, name, color, subscribed):
    dtstart = sub.get("DTSTART")
    if dtstart is None:
        return None
    start_iso, all_day = as_local_datetime(dtstart.dt, tz)
    if start_iso is None:
        return None

    dtend = sub.get("DTEND")
    if dtend is not None:
        end_iso, _ = as_local_datetime(dtend.dt, tz)
    else:
        duration = sub.get("DURATION")
        end_iso = as_local_datetime(dtstart.dt + duration.dt, tz)[0] if duration is not None else start_iso

    return {
        "uid": str(sub.get("UID", "") or ""),
        # A repeating event shares one UID across every occurrence, so
        # deleting by UID takes the whole series. The panel has to be able
        # to say so before it asks.
        "recurring": bool(sub.get("RRULE") or sub.get("RECURRENCE-ID")),
        "summary": clean_line(sub.get("SUMMARY", ""), SUMMARY_LIMIT) or "(no title)",
        "description": clean_description(sub.get("DESCRIPTION")),
        "location": clean_line(sub.get("LOCATION", ""), LOCATION_LIMIT),
        "start": start_iso,
        "end": end_iso or start_iso,
        "allDay": all_day,
        "calendar": name,
        "color": color,
        "subscribed": subscribed,
    }


# ---------------------------------------------------------------- feeds

def feed_address(url):
    """The https address a subscription actually points at.

    webcal is plain https wearing a scheme that tells the OS to subscribe
    rather than download, so it is rewritten and then held to the same rule as
    everything else.
    """
    text = str(url or "").strip()
    if text.lower().startswith("webcal://"):
        text = "https://" + text[len("webcal://"):]
    return require_https(text, "a calendar feed")


def check_destination(url, allow_private):
    """Refuse to fetch from an address that is not the internet.

    A pasted feed URL is the user's own choice, and a calendar served off the
    machine next to them is a fair thing to want, so a private address is
    allowed where they typed one. A redirect is not their choice: it is the
    remote end naming somewhere else to go, and somewhere else must not mean
    this machine's own loopback, the link-local range that holds cloud
    metadata services, or the network behind the router.

    Resolving here and letting the HTTP library resolve again leaves a window
    where a name could answer differently the second time. Closing it properly
    means pinning the connection to the address checked, which cannot be done
    without taking over certificate verification as well. This is the check
    that stops a redirect from walking into the LAN, not a guarantee against a
    DNS server actively lying in the space of one request.
    """
    import ipaddress
    import socket
    import urllib.parse

    parsed = urllib.parse.urlsplit(url)
    host = parsed.hostname
    if not host:
        raise RuntimeError("that address has no host in it")

    try:
        infos = socket.getaddrinfo(host, parsed.port or 443, proto=socket.IPPROTO_TCP)
    except OSError:
        raise RuntimeError("no connection")

    for info in infos:
        address = ipaddress.ip_address(info[4][0])
        # ::ffff:127.0.0.1 is the loopback wearing a v6 address, and answers
        # False to is_loopback in that form. Unwrap before asking.
        mapped = getattr(address, "ipv4_mapped", None)
        if mapped is not None:
            address = mapped
        if address.is_loopback or address.is_link_local or address.is_multicast \
                or address.is_reserved or address.is_unspecified:
            raise RuntimeError("that address is not on the internet")
        if not allow_private and address.is_private:
            raise RuntimeError("that feed redirected to a private address")
    return url


def read_capped(response):
    """The feed's bytes, up to a limit, rather than whatever it decides to send.

    Without this a feed that answers with an endless stream takes the machine's
    memory with it, and nothing about the request says how much is coming: a
    Content-Length is a claim, not a promise, so it is checked when offered and
    the actual read is counted regardless.
    """
    declared = response.headers.get("Content-Length")
    if declared and declared.isdigit() and int(declared) > MAX_FEED_BYTES:
        raise RuntimeError("that calendar is too large to read")

    chunks, total = [], 0
    for chunk in response.iter_content(64 * 1024):
        total += len(chunk)
        if total > MAX_FEED_BYTES:
            raise RuntimeError("that calendar is too large to read")
        chunks.append(chunk)
    return b"".join(chunks)


def fetch_feed(url):
    """Fetch a feed, following redirects one at a time and checking each hop.

    requests would follow them on its own, but then the only address ever
    checked is the one that was typed, and the check that matters is the one on
    the address actually contacted.
    """
    import requests

    target = check_destination(feed_address(url), allow_private=True)
    session = requests.Session()
    # No .netrc, no proxy picked up from the environment: this request carries
    # no credentials and should not acquire any on the way out.
    session.trust_env = False
    try:
        for _ in range(MAX_REDIRECTS + 1):
            response = session.get(target, timeout=NETWORK_TIMEOUT, stream=True,
                                   allow_redirects=False,
                                   headers={"User-Agent": "omadates"})
            if response.is_redirect or response.is_permanent_redirect:
                location = response.headers.get("Location", "")
                response.close()
                if not location:
                    raise RuntimeError("the server redirected to nowhere")
                target = check_destination(
                    feed_address(requests.compat.urljoin(target, location)),
                    allow_private=False)
                continue
            with response:
                response.raise_for_status()
                # The raw bytes, not response.text: requests falls back to
                # ISO-8859-1 for text/* without a declared charset, which turns
                # every accented letter into mojibake. RFC 5545 says iCalendar
                # is UTF-8, and icalendar decodes bytes on that assumption.
                return read_capped(response)
        raise RuntimeError("that calendar redirected too many times")
    finally:
        session.close()


def fetch_subscription(entry, start, end, tz):
    """One subscribed .ics feed, expanded over the same window as CalDAV."""
    import icalendar
    import recurring_ical_events

    url = str(entry.get("url") or "").strip()
    if not url:
        return [], "", ""

    calendar = icalendar.Calendar.from_ical(fetch_feed(url))

    name = (str(entry.get("name") or "").strip()
            or str(calendar.get("X-WR-CALNAME", "") or "").strip()
            or "Subscribed")
    color = normalise_hex(calendar.get("X-APPLE-CALENDAR-COLOR", ""))

    events = []
    for sub in recurring_ical_events.of(calendar).between(start, end):
        built = build_event(sub, tz, name, color, subscribed=True)
        if built:
            events.append(built)
        if len(events) >= MAX_EVENTS:
            break
    return events, name, color


# ---------------------------------------------------------------- cache

def cache_state():
    """Facts the panel needs to choose what to offer, on every write."""
    try:
        config = load_config()
    except Exception:
        config = {}
    return {
        "configured": bool(str(config.get("username") or "").strip())
                      or bool(config.get("subscriptions")),
        "signedIn": bool(str(config.get("username") or "").strip()),
        "missing": missing_dependencies(),
    }


def write_cache(payload):
    for key, value in cache_state().items():
        payload.setdefault(key, value)
    write_private(CACHE_PATH, json.dumps(payload, indent=2, ensure_ascii=False) + "\n")


# What a failed run hands forward from the last good one. Events were always
# kept — a dropped connection should not blank the calendar — but the calendar
# lists were not, and the panel decides from those whether an event can be
# added at all. One flaky sync took the "New event" action away with it.
CARRIED_FORWARD = ("events", "syncedAt", "calendars")


def last_good():
    try:
        old = json.loads(read_private(CACHE_PATH))
    except Exception:
        return {}
    if not isinstance(old, dict):
        return {}
    return {key: old[key] for key in CARRIED_FORWARD if key in old}


def edit_cache(change):
    """Apply a change to the whole cache without going back to the server.

    The write has already happened; making someone wait out a full re-sync
    before the panel admits it turns a one-second action into five, and into
    an indefinite wait on a bad line. The next scheduled sync reconciles.

    The change is handed the entire cache rather than only its events: the
    panel reads colours from the calendar list, and touching one without the
    other leaves the two disagreeing about what colour a calendar is.
    """
    try:
        cache = json.loads(read_private(CACHE_PATH))
    except Exception:
        return
    if not isinstance(cache, dict):
        return
    change(cache)
    if isinstance(cache.get("events"), list):
        cache["events"].sort(key=lambda e: (e.get("start", ""), e.get("summary", "")))
    write_cache(cache)


def cache_status():
    """What the panel is currently saying about the last sync."""
    try:
        return str(json.loads(read_private(CACHE_PATH)).get("status") or "")
    except Exception:
        return ""


def cached_colour(name):
    """The colour the calendar list already knows, for an event written now."""
    try:
        cache = json.loads(read_private(CACHE_PATH))
        for entry in cache.get("calendars", []):
            if entry.get("name") == name:
                return entry.get("color", "")
    except Exception:
        pass
    return ""


def fail(message):
    payload = {
        "status": "error",
        "error": message,
        "checkedAt": datetime.now(timezone.utc).isoformat(),
        "syncedAt": "",
        "events": [],
    }
    payload.update(last_good())
    write_cache(payload)
    print(f"omadates-sync: {message}", file=sys.stderr)
    return 1


# ---------------------------------------------------------------- commands

def missing_dependencies():
    missing = []
    for module, package in REQUIREMENTS:
        try:
            __import__(module)
        except ImportError:
            missing.append(package)
    if not shutil_which("secret-tool"):
        missing.append("libsecret")
    return missing


def shutil_which(name):
    import shutil
    return shutil.which(name)


def parse_local(text, tz):
    """An ISO-ish local timestamp from the panel, without a timezone on it."""
    value = str(text or "").strip().replace(" ", "T")
    for fmt in ("%Y-%m-%dT%H:%M", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d"):
        try:
            return datetime.strptime(value, fmt).replace(tzinfo=tz)
        except ValueError:
            continue
    raise ValueError(f"could not read the time '{text}'")


def cmd_create(args):
    """Write one event to a CalDAV calendar.

    The payload arrives as JSON on stdin rather than as arguments: a summary
    or a note can hold quotes, newlines and anything else a shell would take
    an interest in, and none of that belongs in a process list either.

    Subscribed feeds are read-only by nature, so only calendars the account
    actually owns can be named here.
    """
    import icalendar

    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except Exception as exc:
        print(f"omadates-sync: unreadable payload: {exc}", file=sys.stderr)
        return 2
    if not isinstance(payload, dict):
        print("omadates-sync: payload must be an object", file=sys.stderr)
        return 2

    summary = str(payload.get("summary") or "").strip()
    target = str(payload.get("calendar") or "").strip()
    if not summary:
        return fail("an event needs a title")
    if not target:
        return fail("no calendar chosen")

    config = load_config()
    username = str(config.get("username") or "").strip()
    if not username:
        return fail("not signed in")

    tz = local_tz()
    all_day = payload.get("allDay") is True
    try:
        start = parse_local(payload.get("start"), tz)
        end = parse_local(payload.get("end"), tz) if payload.get("end") else None
    except ValueError as exc:
        return fail(str(exc))
    if end is None or end <= start:
        end = start + timedelta(days=1 if all_day else 0, hours=0 if all_day else 1)

    event = icalendar.Event()
    event.add("summary", summary)
    if payload.get("location"):
        event.add("location", str(payload["location"]).strip())
    if payload.get("description"):
        event.add("description", str(payload["description"]))
    if all_day:
        event.add("dtstart", start.date())
        event.add("dtend", max(end.date(), start.date() + timedelta(days=1)))
    else:
        # UTC rather than a local TZID. A bare abbreviation like CEST is not a
        # timezone identifier, and a real one obliges the file to carry a
        # VTIMEZONE block describing it. UTC needs neither and every server
        # reads it the same way; the phone renders it back in local time.
        event.add("dtstart", start.astimezone(timezone.utc))
        event.add("dtend", end.astimezone(timezone.utc))
    event.add("dtstamp", datetime.now(timezone.utc))
    event.add("uid", f"{uuid.uuid4()}@omadates")

    calendar = icalendar.Calendar()
    calendar.add("prodid", "-//omadates//EN")
    calendar.add("version", "2.0")
    calendar.add_component(event)

    if payload.get("dryRun") is True:
        print(calendar.to_ical().decode())
        return 0

    try:
        calendars = account_calendars(config, username)
    except Exception as exc:
        return fail(friendly_error(exc))

    for candidate in calendars:
        if calendar_name(candidate, "") == target:
            try:
                candidate.save_event(calendar.to_ical().decode())
            except Exception as exc:
                return fail(friendly_error(exc))
            break
    else:
        return fail(f"no calendar named '{target}'")

    built = build_event(event, tz, target, cached_colour(target), subscribed=False)
    if built:
        def add(cache):
            cache.setdefault("events", []).append(built)
        edit_cache(add)
    print(f"omadates-sync: created '{summary}'")
    return 0


def cmd_delete(args):
    """Remove one event by UID from a calendar the account owns.

    A subscribed feed is somebody else's file, so nothing here can touch it.
    Deleting by UID takes every occurrence of a repeating event, which is why
    the panel says as much before it asks.
    """
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except Exception as exc:
        print(f"omadates-sync: unreadable payload: {exc}", file=sys.stderr)
        return 2

    uid = str(payload.get("uid") or "").strip()
    target = str(payload.get("calendar") or "").strip()
    if not uid:
        return fail("that event has no identifier to delete by")
    if not target:
        return fail("no calendar given")

    config = load_config()
    username = str(config.get("username") or "").strip()
    if not username:
        return fail("not signed in")

    try:
        calendars = account_calendars(config, username)
    except Exception as exc:
        return fail(friendly_error(exc))

    for candidate in calendars:
        if calendar_name(candidate, "") != target:
            continue
        if not takes_events(candidate):
            return fail("that calendar does not hold events")
        found = None
        # iCloud answers the UID-based REPORT that event_by_uid issues with
        # 412 Precondition Failed, so that is tried once and then set aside
        # for a search over the days around the event. The panel knows when
        # the event is, which keeps the window small.
        try:
            found = candidate.event_by_uid(uid)
        except Exception:
            found = None

        if found is None:
            tz = local_tz()
            try:
                around = parse_local(payload.get("start"), tz)
            except ValueError:
                around = datetime.now(tz)
            try:
                items = candidate.search(start=around - timedelta(days=2),
                                         end=around + timedelta(days=2), event=True)
            except Exception as exc:
                return fail(friendly_error(exc))
            for item in items:
                try:
                    components = item.icalendar_instance.walk("VEVENT")
                except Exception:
                    continue
                if any(str(c.get("UID", "")) == uid for c in components):
                    found = item
                    break

        if found is None:
            return fail("that event is no longer on the server")
        try:
            found.delete()
        except Exception as exc:
            return fail(friendly_error(exc))
        break
    else:
        return fail(f"no calendar named '{target}'")

    def drop(cache):
        cache["events"] = [e for e in cache.get("events", []) if e.get("uid") != uid]
    edit_cache(drop)
    print(f"omadates-sync: deleted {uid}")
    return 0


def read_tokens():
    try:
        loaded = json.loads(read_private(TOKENS_PATH))
        return loaded if isinstance(loaded, dict) else {}
    except Exception:
        return {}


def write_tokens(tokens):
    try:
        write_private(TOKENS_PATH, json.dumps(tokens, indent=2))
    except Exception:
        pass


def collection_tokens(calendars):
    """One opaque marker per calendar, which changes when its contents do.

    RFC 6578. The server works out whether anything moved; this end only has
    to notice that the string is different, which is why the question costs a
    fraction of what fetching the events costs.
    """
    tokens = {}
    for calendar in calendars:
        name = calendar_name(calendar, "")
        if not name:
            continue
        try:
            tokens[name] = str(calendar.objects_by_sync_token(load_objects=False).sync_token)
        except Exception:
            # A server that will not answer is treated as changed, so the
            # fallback is a needless sync rather than a missed one.
            tokens[name] = ""
    return tokens


def cmd_poll():
    """Ask whether anything changed, and only then do the expensive thing."""
    config = load_config()
    username = str(config.get("username") or "").strip()
    if not username:
        return 0

    try:
        calendars = account_calendars(config, username)
    except Exception:
        # A poll that cannot reach the server says nothing at all: the cache
        # keeps its last good answer, and the periodic full sync will report
        # the trouble in its own words.
        return 0

    fresh = collection_tokens(calendars)
    known = read_tokens()
    # Equal sets, not a superset: a calendar that is no longer there is a
    # change, and comparing only the ones that remain would miss it.
    if fresh and known and set(known) == set(fresh) \
            and all(known.get(k) == v and v != "" for k, v in fresh.items()):
        # Nothing moved, but getting an answer at all settles the other
        # question. If the last sync failed, the panel is still showing that
        # failure, and a poll that reached the server has just disproved it.
        # Saying "unchanged" here would leave "no connection" on screen over
        # a connection that plainly works.
        if cache_status() == "error":
            print("omadates-sync: unchanged, clearing stale error")
            return cmd_sync()
        print("omadates-sync: unchanged")
        return 0

    print("omadates-sync: something changed")
    return cmd_sync()


def cmd_newcalendar(args):
    """Make a calendar on the server, which is where the phone will find it.

    A full sync follows rather than a cache edit: a new calendar changes what
    can be written to and what can be switched on, and those lists are read
    from the sync, not guessed at here.
    """
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except Exception as exc:
        print(f"omadates-sync: unreadable payload: {exc}", file=sys.stderr)
        return 2

    name = str(payload.get("name") or "").strip()
    colour = normalise_hex(payload.get("color"))
    if not name:
        return fail("a calendar needs a name")

    config = load_config()
    username = str(config.get("username") or "").strip()
    if not username:
        return fail("not signed in")

    from caldav.elements import ical
    try:
        password = keyring_lookup(username)
        principal = dav_client(config, username, password).principal()
    except Exception as exc:
        return fail(friendly_error(exc))

    if name in [calendar_name(c, "") for c in principal.calendars()]:
        return fail(f"there is already a calendar called '{name}'")

    try:
        created = principal.make_calendar(name=name, cal_id=str(uuid.uuid4()))
    except Exception as exc:
        return fail(friendly_error(exc))

    if colour:
        try:
            created.set_properties([ical.CalendarColor(colour + "FF")])
        except Exception:
            # The calendar exists either way; a colour that would not take is
            # not worth undoing it over.
            pass

    print(f"omadates-sync: created calendar '{name}'")
    return cmd_sync()


def cmd_deletecalendar(args):
    """Remove a calendar, or stop following a feed.

    The two are not the same act. Deleting a calendar the account owns takes
    it and everything in it off the server, on every device. Dropping a
    subscription only forgets a URL; whoever publishes it is unaffected and
    can be followed again by pasting it back.
    """
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except Exception as exc:
        print(f"omadates-sync: unreadable payload: {exc}", file=sys.stderr)
        return 2

    name = str(payload.get("name") or "").strip()
    url = str(payload.get("url") or "").strip()
    if not name and not url:
        return fail("no calendar given")

    if url:
        config = load_config()
        before = config.get("subscriptions") or []
        config["subscriptions"] = [e for e in before if e.get("url") != url]
        if len(config["subscriptions"]) == len(before):
            return fail("that subscription is not in the list")
        save_config(config)
        print(f"omadates-sync: stopped following '{name or url}'")
        return cmd_sync()

    config = load_config()
    username = str(config.get("username") or "").strip()
    if not username:
        return fail("not signed in")

    try:
        calendars = account_calendars(config, username)
    except Exception as exc:
        return fail(friendly_error(exc))

    for candidate in calendars:
        if calendar_name(candidate, "") != name:
            continue
        try:
            candidate.delete()
        except Exception as exc:
            return fail(friendly_error(exc))
        break
    else:
        return fail(f"no calendar named '{name}'")

    print(f"omadates-sync: deleted calendar '{name}'")
    return cmd_sync()


def cmd_colour(args):
    """Set a calendar's colour on the server, where every device reads it.

    Apple stores this as #RRGGBBAA on the collection itself, so the change
    reaches the phone the same way a new event does. Only calendars the
    account owns can take it: a subscribed feed is somebody else's file, and
    its colour stays a local note.
    """
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except Exception as exc:
        print(f"omadates-sync: unreadable payload: {exc}", file=sys.stderr)
        return 2

    target = str(payload.get("calendar") or "").strip()
    colour = normalise_hex(payload.get("color"))
    if not target:
        return fail("no calendar given")
    if not colour:
        return fail("that is not a colour")

    config = load_config()
    username = str(config.get("username") or "").strip()
    if not username:
        return fail("not signed in")

    from caldav.elements import ical
    try:
        calendars = account_calendars(config, username)
    except Exception as exc:
        return fail(friendly_error(exc))

    for candidate in calendars:
        if calendar_name(candidate, "") != target:
            continue
        try:
            # Alpha appended because that is the shape Apple writes and reads.
            candidate.set_properties([ical.CalendarColor(colour + "FF")])
        except Exception as exc:
            return fail(friendly_error(exc))
        break
    else:
        return fail(f"no calendar named '{target}'")

    def recolour(cache):
        for event in cache.get("events", []):
            if event.get("calendar") == target:
                event["color"] = colour
        # The dot beside the name is drawn from this list, not from the
        # events, so it is the half that actually shows.
        for entry in cache.get("calendars", []):
            if entry.get("name") == target:
                entry["color"] = colour

    edit_cache(recolour)
    print(f"omadates-sync: {target} is now {colour}")
    return 0


def cmd_map(args):
    """Open a location in whatever this system uses for maps.

    A registered geo: handler is the machine's own answer to "show me this
    place", which is the one worth honouring: Omarchy ships handlers for
    Google Maps, OpenStreetMap and Wheelmap, and which one runs is the user's
    choice, not this plugin's. The web search is only for systems where
    nothing has claimed the scheme.
    """
    import shutil
    import urllib.parse

    query = " ".join(args).strip()
    if not query:
        print("omadates-sync: map needs a location", file=sys.stderr)
        return 2
    # gio first, xdg-open second. xdg-open exits 0 and does nothing at all
    # for a geo: URI on a desktop it does not recognise, which is a silent
    # failure and the worst kind; gio consults the same handler registry and
    # actually launches it.
    opener = shutil.which("gio")
    launch = [opener, "open"] if opener else None
    if launch is None:
        opener = shutil.which("xdg-open")
        launch = [opener] if opener else None
    if launch is None:
        print("omadates-sync: neither gio nor xdg-open is installed", file=sys.stderr)
        return 1

    encoded = urllib.parse.quote(query)
    target = "https://www.google.com/maps/search/?api=1&query=" + encoded
    if shutil.which("xdg-mime"):
        try:
            handler = subprocess.run(
                ["xdg-mime", "query", "default", "x-scheme-handler/geo"],
                capture_output=True, text=True, timeout=5).stdout.strip()
            if handler:
                target = "geo:0,0?q=" + encoded
        except Exception:
            pass

    # Detached, so closing the panel or the shell never takes the map with it.
    subprocess.Popen(launch + [target], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    focus_browser()
    print("omadates-sync: opened " + target)
    return 0


def browser_classes():
    """What the window of the machine's default browser is likely called.

    Taken from the handler's own desktop file: StartupWMClass when it names
    one, and the file's own name otherwise, which is what most browsers end
    up using anyway.
    """
    import shutil
    if not shutil.which("xdg-mime"):
        return []
    try:
        desktop = subprocess.run(["xdg-mime", "query", "default", "x-scheme-handler/https"],
                                 capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return []
    if not desktop:
        return []

    names = [desktop[:-len(".desktop")] if desktop.endswith(".desktop") else desktop]
    roots = [Path("/usr/share/applications"), Path("/usr/local/share/applications"),
             Path.home() / ".local/share/applications"]
    for root in roots:
        path = root / desktop
        if not path.exists():
            continue
        try:
            for line in path.read_text().splitlines():
                if line.startswith("StartupWMClass="):
                    names.insert(0, line.split("=", 1)[1].strip())
                    break
        except Exception:
            pass
        break
    # Some packages ship the template variable unsubstituted, so a value has
    # to look like a window class before it is trusted as one.
    return [n for n in names if n and "@" not in n and " " not in n]


def focus_browser():
    """Bring the browser to you, rather than leaving the tab on another desk.

    Opening a map in an existing browser session adds a tab to a window that
    may be two workspaces away, so from where you are sitting nothing happens
    at all. Chromium sends no activation request on this path, so the focus
    has to be asked for.
    """
    import shutil
    import time
    if not shutil.which("hyprctl"):
        return
    wanted = [n.lower() for n in browser_classes()]
    if not wanted:
        return

    # A running browser is focused at once; one starting cold needs a moment
    # to put a window up.
    for _ in range(12):
        try:
            clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"],
                                                capture_output=True, text=True,
                                                timeout=5).stdout or "[]")
        except Exception:
            return
        for client in clients:
            name = str(client.get("class") or "").lower()
            if not name:
                continue
            if any(w in name or name in w for w in wanted):
                address = str(client.get("address") or "")
                if address:
                    subprocess.run(["hyprctl", "dispatch",
                                    'hl.dsp.focus({ window = "address:%s" })' % address],
                                   capture_output=True, timeout=5)
                return
        time.sleep(0.25)


def cmd_check():
    missing = missing_dependencies()
    print(json.dumps({"ok": not missing, "missing": missing}))
    return 0


# The panel prints whatever comes back from here, in a space a few words wide.
# Library exceptions are neither: a urllib3 connection error runs to three
# lines of object addresses and nested causes, and saying that to someone whose
# wifi dropped tells them nothing they can act on.
ERROR_SIGNS = [
    (("Name or service not known", "NameResolutionError", "Temporary failure in name resolution",
      "Failed to resolve", "getaddrinfo"), "no connection"),
    (("Connection refused", "ConnectionError", "Max retries exceeded",
      "Network is unreachable", "Connection aborted"), "no connection"),
    (("timed out", "Timeout", "ReadTimeout", "ConnectTimeout"), "the server did not answer in time"),
    (("SSLError", "CERTIFICATE_VERIFY_FAILED", "SSLCertVerification"), "the server's certificate could not be verified"),
    (("401", "Unauthorized", "Forbidden"),
     "the server rejected the sign-in. Check the Apple ID, and note that "
     "this needs an app-specific password, not your usual one"),
    (("404", "Not Found"), "the server had nothing at that address"),
    (("5033", "500", "502", "503", "Server Error"), "the server is having trouble. Try again shortly"),
]

# Long enough for a real sentence, short enough that an unrecognised error
# cannot push the calendar off the panel.
ERROR_LIMIT = 120


def friendly_error(exc):
    detail = str(exc).strip()
    for signs, message in ERROR_SIGNS:
        if any(sign in detail for sign in signs):
            return message
    # Nothing recognised. Keep the first line so the cause is not lost, but
    # cut it to something a panel can hold.
    first = detail.splitlines()[0] if detail else exc.__class__.__name__
    return first if len(first) <= ERROR_LIMIT else first[:ERROR_LIMIT].rstrip() + "…"


def verify_credentials(url, username, password):
    """Prove the credentials work before they are written anywhere.

    Storing first and checking afterwards means one typo on a re-authentication
    replaces a working password with a broken one, and the only symptom is a
    calendar that quietly stops updating.
    """
    dav_client({"url": url}, username, password).principal().calendars()


def cmd_login(args):
    if not args:
        return fail("login needs an Apple ID")
    username = args[0].strip()
    if not username:
        return fail("login needs an Apple ID")
    # Read from stdin so the password never appears in the process list.
    password = sys.stdin.read().strip("\n")
    if not password:
        return fail("no password given")

    config = load_config()
    try:
        verify_credentials(str(config["url"]), username, password)
    except Exception as exc:
        return fail(friendly_error(exc))

    try:
        keyring_store(username, password)
    except RuntimeError as exc:
        return fail(str(exc))

    config["username"] = username
    save_config(config)
    return cmd_sync()


def cmd_logout():
    config = load_config()
    username = str(config.get("username") or "")
    if username:
        keyring_clear(username)
    config["username"] = ""
    save_config(config)
    write_cache({
        "status": "empty", "error": "", "syncedAt": "",
        "checkedAt": datetime.now(timezone.utc).isoformat(), "events": [],
    })
    print("omadates-sync: signed out")
    return 0


def cmd_subscribe(args):
    if not args:
        return fail("subscribe needs a URL")
    url = args[0].strip()
    name = args[1].strip() if len(args) > 1 else ""
    # Checked now rather than at the first fetch, so a bad address is refused
    # while the person who typed it is still looking at it.
    try:
        check_destination(feed_address(url), allow_private=True)
    except RuntimeError as exc:
        return fail(str(exc))

    config = load_config()
    subs = config.get("subscriptions") or []
    for entry in subs:
        if entry.get("url") == url:
            # Re-subscribing updates the name instead of duplicating the feed.
            if name:
                entry["name"] = name
            break
    else:
        entry = {"url": url}
        if name:
            entry["name"] = name
        subs.append(entry)
    config["subscriptions"] = subs
    save_config(config)
    return cmd_sync()


def cmd_unsubscribe(args):
    if not args:
        return fail("unsubscribe needs a URL")
    url = args[0].strip()
    config = load_config()
    config["subscriptions"] = [e for e in (config.get("subscriptions") or [])
                               if e.get("url") != url]
    save_config(config)
    return cmd_sync()


def cmd_sync():
    missing = missing_dependencies()
    if missing:
        return fail("missing packages: " + " ".join(missing))

    try:
        config = load_config()
    except RuntimeError as exc:
        return fail(str(exc))

    username = str(config.get("username") or "").strip()
    subscriptions = config.get("subscriptions") or []
    if not username and not subscriptions:
        return fail("not connected")

    tz = local_tz()
    now = datetime.now(tz)
    start = now - timedelta(days=int(config["daysBack"]))
    end = now + timedelta(days=int(config["daysAhead"]))
    wanted = [str(n) for n in (config.get("calendars") or [])]

    events, problems = [], []
    # The calendars in their own right, not inferred from the events in them.
    # A calendar you just made has nothing in it yet and would otherwise be
    # invisible here, and its colour would be unknown until something was put
    # in it, which is a strange way to learn what colour it is.
    calendars_meta = []

    if username:
        try:
            calendars = account_calendars(config, username)
        except Exception as exc:
            return fail(friendly_error(exc))

        for calendar in calendars:
            name = calendar_name(calendar, "Calendar")
            colour = calendar_color(calendar)
            calendars_meta.append({
                "name": name, "color": colour,
                "writable": takes_events(calendar), "subscribed": False,
            })
            if wanted and name not in wanted:
                continue
            try:
                events.extend(collect_caldav(calendar, start, end, tz, name, colour))
            except Exception as exc:
                problems.append(f"{name}: {friendly_error(exc)}")

    # A bad feed fails on its own rather than taking the whole sync down.
    for entry in subscriptions:
        label = str(entry.get("name") or entry.get("url") or "subscription")
        try:
            fetched, name, colour = fetch_subscription(entry, start, end, tz)
            events.extend(fetched)
            if name:
                calendars_meta.append({
                    "name": name,
                    # From the feed's own header, not from the first event in
                    # it: a feed with nothing in this month would otherwise
                    # have no colour until something landed in the window.
                    "color": colour,
                    "writable": False, "subscribed": True,
                    # Kept so the panel can say which subscription to drop:
                    # the name shown is whatever the feed calls itself, which
                    # is not what the config is keyed by.
                    "url": str(entry.get("url") or ""),
                })
        except Exception as exc:
            problems.append(f"{label}: {friendly_error(exc)}")

    if problems and not events:
        return fail("; ".join(problems))

    if username:
        write_tokens(collection_tokens(calendars))

    events.sort(key=lambda e: (e["start"], e["summary"]))
    if len(events) > MAX_EVENTS:
        # The window is four months wide, so this is a feed misbehaving rather
        # than a busy diary. Better a truncated month than a shell that stalls
        # laying out a hundred thousand rows.
        problems.append(f"showing the first {MAX_EVENTS} events of {len(events)}")
        events = events[:MAX_EVENTS]
    write_cache({
        "status": "ok",
        "error": "; ".join(problems),
        "checkedAt": datetime.now(timezone.utc).isoformat(),
        "syncedAt": datetime.now(timezone.utc).isoformat(),
        "calendars": calendars_meta,
        "events": events,
    })
    print(f"omadates-sync: {len(events)} events from {len(calendars_meta)} calendars")
    return 0


def tighten_existing_state():
    """Take the private files private, including ones written before this.

    Every write from here on makes them 0600 inside a 0700 directory, but a
    machine that ran an earlier version already has a world-readable cache
    sitting there holding the title of every appointment. Nothing but this
    line would ever narrow it.
    """
    for path in (CONFIG_PATH, CACHE_PATH, TOKENS_PATH):
        try:
            if path.parent.is_dir():
                os.chmod(path.parent, STATE_DIR_MODE)
            if path.is_file():
                os.chmod(path, STATE_MODE)
        except OSError:
            pass


def main(argv):
    tighten_existing_state()
    command = argv[0] if argv else "sync"
    rest = argv[1:]
    if command in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if command == "check":
        return cmd_check()
    if command == "poll":
        return cmd_poll()
    if command == "map":
        return cmd_map(rest)
    if command == "create":
        return cmd_create(rest)
    if command == "delete":
        return cmd_delete(rest)
    if command == "colour":
        return cmd_colour(rest)
    if command == "newcalendar":
        return cmd_newcalendar(rest)
    if command == "deletecalendar":
        return cmd_deletecalendar(rest)
    if command == "login":
        return cmd_login(rest)
    if command == "logout":
        return cmd_logout()
    if command == "subscribe":
        return cmd_subscribe(rest)
    if command == "unsubscribe":
        return cmd_unsubscribe(rest)
    if command == "sync":
        return cmd_sync()
    print(f"omadates-sync: unknown command '{command}'. Try --help.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except Exception:
        traceback.print_exc()
        sys.exit(fail("unexpected failure"))
